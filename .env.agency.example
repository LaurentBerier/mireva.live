# Copy to .env; keep this file free of live credentials.
AUTH_PROVIDER=supabase
VERCEL_SERVICES=false
IS_GENERAL=true
DISABLE_REGISTRATION=true
FRONTEND_URL=http://localhost:4200
MAIN_URL=http://localhost:4200
NEXT_PUBLIC_BACKEND_URL=/api/backend
BACKEND_INTERNAL_URL=http://localhost:3000
PUBLIC_BACKEND_URL=http://localhost:3000
DEPLOYMENT_ENVIRONMENT=development
PUBLISHING_ENABLED=false
ENGAGEMENT_ENABLED=false
ADS_WRITES_ENABLED=false
RUN_AGENCY_SYNC=false
WORKER_ACTIVITY_CONCURRENCY=2
RELEASE_TAG=agency-2026-11-19
API_DOMAIN=api.example.com
ACME_EMAIL=operations@example.com
TEMPORAL_DB_PASSWORD=
AGENCY_EXTENSION_ORIGINS=http://localhost:4200
RUN_CRON=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Application tables live in the unexposed postiz schema.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres?schema=postiz
DIRECT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55322/postgres?schema=postiz
REDIS_URL=redis://127.0.0.1:56379
TEMPORAL_ADDRESS=127.0.0.1:57233
TEMPORAL_NAMESPACE=agency-workspace

SUPABASE_URL=http://127.0.0.1:55321
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
STORAGE_PROVIDER=supabase
SUPABASE_STORAGE_BUCKET=agency-media
SUPABASE_STORAGE_REGION=local
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

ENCRYPTION_PROVIDER=local
ENCRYPTION_KEY=
# Backend notification/report email remains inactive until SMTP is configured.
EMAIL_PROVIDER=
EMAIL_HOST=127.0.0.1
EMAIL_PORT=55325
EMAIL_USER=
EMAIL_PASS=
EMAIL_SECURE=false
EMAIL_FROM_NAME=Agency Workspace
EMAIL_FROM_ADDRESS=agency@example.test

# Bootstrap sends an invitation, never a generated password.
AGENCY_NAME=My Agency
AGENCY_OWNER_EMAIL=
AGENCY_FIRST_BRAND=My Brand

# Optional paid capabilities are inactive until their keys are configured.
OPENAI_API_KEY=
NEXT_PUBLIC_AI_ENABLED=false
NEXT_PUBLIC_POLOTNO=
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
RUNPOD_INGEST_ENDPOINT_ID=
RUNPOD_CLIPPER_ENDPOINT_ID=
DEEPGRAM_API_KEY=
GRAPH_API_VERSION=v27.0
GOOGLE_ADS_API_VERSION=v26
TIKTOK_BUSINESS_API_VERSION=v1.3
