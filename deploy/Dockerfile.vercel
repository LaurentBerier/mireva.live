FROM node:22.23.4-bookworm-slim AS source
RUN corepack enable && corepack prepare pnpm@10.6.1 --activate
RUN apt-get update && apt-get install -y --no-install-recommends git python3 make g++ openssl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /source
COPY . .
# The remote Docker build has no .git directory. A temporary index lets the
# existing packager retain tracked templates even when .gitignore ignores them.
# The Dockerfile-specific ignore file is the build-context privacy boundary.
RUN git init --quiet && git add --force . && node scripts/agency-source.mjs && mkdir /app && tar -xzf deploy/corresponding-source.tar.gz -C /app && mkdir -p /app/deploy && cp deploy/corresponding-source.tar.gz /app/deploy/corresponding-source.tar.gz
FROM source AS build
WORKDIR /app
RUN pnpm install --frozen-lockfile
RUN NODE_OPTIONS=--max-old-space-size=6144 pnpm run agency:build:services

FROM node:22.23.4-bookworm-slim AS runtime
COPY deploy/certs/supabase-root-2021.crt /usr/local/share/ca-certificates/supabase-root-2021.crt
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates && update-ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /app /app
ENV NODE_ENV=production
ENV NODE_OPTIONS=--max-old-space-size=1024
ENV NODE_EXTRA_CA_CERTS=/app/deploy/certs/supabase-root-2021.crt
USER node
EXPOSE 3000
CMD ["node", "scripts/agency-run-vercel.cjs", "backend"]
